name: dockercompose10717315224051092020
services:
  db:
    environment:
      POSTGRES_DB: platita_db
      POSTGRES_PASSWORD: platita2025-jotaeseon
      POSTGRES_USER: platita_user
    image: postgres:16.8
    networks:
      default: null
    restart: always
    volumes:
      - type: volume
        source: pgdata
        target: /var/lib/postgresql/data
        volume: {}
  web:
    build:
      context: C:\Users\54346\Desktop\Platita_API
      dockerfile: src/Web/Dockerfile
    depends_on:
      db:
        condition: service_started
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Production
      ASPNETCORE_HTTP_PORTS: "5000"
      ASPNETCORE_HTTPS_PORTS: "5001"
      ASPNETCORE_URLS: http://+:5000;https://+:5001
      ConnectionStrings__DefaultConnection: Host=db;Database=platita_db;Username=platita_user;Password=platita2025-jotaeseon
      JWT__AUDIENCE: platita_frontend
      JWT__ISSUER: platita_api
      JWT__KEY: w2Qf94sM1qCt9rUyYxLpMv7HdXeCqGsT
    image: platita_api_v1
    networks:
      default: null
    ports:
      - mode: ingress
        host_ip: 127.0.0.1
        target: 5000
        published: "5000"
        protocol: tcp
      - mode: ingress
        host_ip: 127.0.0.1
        target: 5001
        published: "5001"
        protocol: tcp
      - mode: ingress
        target: 5000
        published: "5000"
        protocol: tcp
      - mode: ingress
        target: 5001
        published: "5001"
        protocol: tcp
    volumes:
      - type: bind
        source: C:\Users\54346\AppData\Roaming/Microsoft/UserSecrets
        target: /home/app/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\54346\AppData\Roaming/Microsoft/UserSecrets
        target: /root/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\54346\AppData\Roaming/ASP.NET/Https
        target: /home/app/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\54346\AppData\Roaming/ASP.NET/Https
        target: /root/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
networks:
  default:
    name: dockercompose10717315224051092020_default
volumes:
  pgdata:
    name: dockercompose10717315224051092020_pgdata